ego_top10_df <- bind_rows(top10_BP, top10_CC, top10_MF)
# Reordenar los términos para graficar (más significativo arriba) dentro de cada ontología
ego_top10_df <- ego_top10_df %>%
group_by(ONTOLOGY) %>%
arrange(p.adjust, .by_group = TRUE) %>%
mutate(Description = factor(Description, levels = rev(unique(Description)))) %>%
ungroup()
# Graficar con ggplot2, dotplot dividido por ontología en paneles facet_wrap
p <- ggplot(ego_top10_df, aes(x = Count, y = Description)) +
geom_point(aes(size = -log10(p.adjust), color = ONTOLOGY)) +
scale_color_manual(values = c(BP = "#1b9e77", CC = "#d95f02", MF = "#7570b3")) +
theme_bw() +
labs(
title = "Top 10 términos GO por ontología (genes sobreexpresados)",
x = "Número de genes",
y = "Término GO",
color = "Ontología",
size = "-log10(p.adjust)"
) +
theme(
axis.text.y = element_text(size = 10),
plot.title = element_text(hjust = 0.5, face = "bold"),
strip.text = element_text(face = "bold", size = 12)
) +
facet_wrap(~ONTOLOGY, scales = "free_y")
print(p)
# Guardar gráfico
ggsave(filename = file.path(output_dir, "GO_dotplot_upregulated_top10_facet.png"), plot = p, width = 12, height = 8)
} else {
message("No se encontraron términos GO enriquecidos significativos para genes sobreexpresados.")
}
################################################################################
### ANÁLISIS DE ENRIQUECIMIENTO GO (genes sobreexpresados - top 10 términos) ###
################################################################################
library(clusterProfiler)
library(org.Hs.eg.db)
library(ggplot2)
library(dplyr)
library(forcats)
# Enriquecimiento GO para genes sobreexpresados (upregulated)
ego_all <- enrichGO(
gene          = up_entrez_ids,
OrgDb         = org.Hs.eg.db,
keyType       = "ENTREZID",
ont           = "ALL",
pAdjustMethod = "BH",
pvalueCutoff  = 0.05,
qvalueCutoff  = 0.2,
readable      = TRUE
)
# Simplificar términos GO redundantes
ego_simplified <- simplify(ego_all, cutoff = 0.7, by = "p.adjust", select_fun = min)
# Guardar todos los términos simplificados en CSV
write.csv(as.data.frame(ego_simplified),
file = file.path(output_dir, "GO_enrichment_upregulated_simplified.csv"),
row.names = FALSE)
# Extraer dataframe con resultados
ego_df <- as.data.frame(ego_simplified)
if (nrow(ego_df) > 0) {
# Seleccionar top 10 términos por cada ontología
top10_BP <- ego_df %>% filter(ONTOLOGY == "BP") %>% arrange(p.adjust) %>% slice_head(n = 10)
top10_CC <- ego_df %>% filter(ONTOLOGY == "CC") %>% arrange(p.adjust) %>% slice_head(n = 10)
top10_MF <- ego_df %>% filter(ONTOLOGY == "MF") %>% arrange(p.adjust) %>% slice_head(n = 10)
# Combinar todos los top 10
ego_top10_df <- bind_rows(top10_BP, top10_CC, top10_MF)
# Convertir ONTOLOGY en factor para facet_wrap
ego_top10_df$ONTOLOGY <- factor(ego_top10_df$ONTOLOGY, levels = c("BP", "CC", "MF"))
# Reordenar Description por ontología para orden correcto en cada panel
ego_top10_df <- ego_top10_df %>%
group_by(ONTOLOGY) %>%
arrange(p.adjust, .by_group = TRUE) %>%
mutate(Description = factor(Description, levels = rev(unique(Description)))) %>%
ungroup()
# Limpiar niveles no usados
ego_top10_df <- droplevels(ego_top10_df)
# Graficar con facet_wrap por Ontología y escalas libres en eje y
p <- ggplot(ego_top10_df, aes(x = Count, y = Description)) +
geom_point(aes(size = -log10(p.adjust), color = ONTOLOGY)) +
scale_color_manual(values = c(BP = "#1b9e77", CC = "#d95f02", MF = "#7570b3")) +
theme_bw() +
labs(
title = "Top 10 términos GO por ontología (genes sobreexpresados)",
x = "Número de genes",
y = "Término GO",
color = "Ontología",
size = "-log10(p.adjust)"
) +
theme(
axis.text.y = element_text(size = 10),
plot.title = element_text(hjust = 0.5, face = "bold"),
strip.text = element_text(face = "bold", size = 12)
) +
facet_wrap(~ONTOLOGY, scales = "free_y")
print(p)
# Guardar gráfico
ggsave(filename = file.path(output_dir, "GO_dotplot_upregulated_top10_facet.png"),
plot = p, width = 12, height = 8)
} else {
message("No se encontraron términos GO enriquecidos significativos para genes sobreexpresados.")
}
